# ============================================================================
#  Copy this file to .env.local for local work, and paste the same keys into
#  Vercel → Project → Settings → Environment Variables for production.
#  Nothing here is required to run `npm run dev` — the site starts with
#  file-based storage and notifications switched off.
# ============================================================================

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Database (REQUIRED in production) -------------------------------------
# Neon (neon.tech) or Supabase, free tier is plenty. Without this, orders are
# written to .data/orders.json, which serverless hosting WIPES on every deploy.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Admin panel (REQUIRED) ------------------------------------------------
# Protects the orders list, which holds customer names, phones and addresses.
ADMIN_PASSWORD=change-this-to-something-long
# Any long random string. Signs the admin session cookie.
ADMIN_SECRET=change-this-too-openssl-rand-base64-32

# --- UPI (REQUIRED to take payments) ---------------------------------------
# Use a MERCHANT / BUSINESS VPA, not your personal UPI ID.
UPI_ID=yourbusiness@okhdfcbank
UPI_PAYEE_NAME=Example Travels
# Optional: give every booking a unique paise value (500.37, 500.82 ...) so
# your bank SMS identifies the booking from the amount alone. Default off.
UPI_UNIQUE_PAISE=false

# --- Telegram alerts (recommended — instant, free, no approvals) -----------
# 1. Message @BotFather on Telegram, send /newbot, copy the token here.
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts (recommended) --------------------------------------------
# resend.com — free tier covers early volume. Verify your domain, then use an
# address on it as EMAIL_FROM. Owner alerts go to BUSINESS.email in config.
RESEND_API_KEY=
EMAIL_FROM=bookings@your-domain.com

# --- WhatsApp (optional, switch on after Meta approves your templates) -----
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NEW_ORDER=booking_received
WHATSAPP_TEMPLATE_CAB_ASSIGNED=cab_assigned

# --- Automatic payment verification (removes the UTR box for customers) -----
# When true, the booking page waits for confirmation instead of asking the
# customer to type a UPI reference. Requires the webhook below to be receiving
# your bank's credit alerts, and works properly only with UPI_UNIQUE_PAISE=true
# (otherwise two bookings with the same advance cannot be told apart).
PAYMENT_AUTO_VERIFY=false

# Shared secret for POST /api/payments/webhook. This endpoint can mark a booking
# as PAID, so treat it like a password: at least 16 characters, random, secret.
# Generate one with:  openssl rand -base64 32
# The endpoint refuses every request while this is unset or too short.
BANK_WEBHOOK_SECRET=
